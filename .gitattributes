# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.tsx text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.js text eol=lf

# Data files
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Stylesheets
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf

# Templates
*.html text eol=lf
*.htm text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=lf

# Config files
*.env text eol=lf
*.env.* text eol=lf

# SQL
*.sql text eol=lf

# Binary files - do not modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.db binary
*.sqlite binary
*.db3 binary
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary
*.mp3 binary
*.mp4 binary
*.avi binary
*.mov binary
*.wmv binary
*.flv binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.tflite binary
*.model binary
