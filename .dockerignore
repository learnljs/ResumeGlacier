# 构建上下文裁剪：把本机产物与个人数据挡在镜像外
node_modules
.next
.next-*
out
build
coverage

# 本机运行时数据（数据库、附件、日志）
data
prisma/data
*.db
*.db.demo
*.db.demo.optout

# 版本控制与编辑器
.git
.gitignore
.github
.vscode
.idea
.workbuddy
.claude

# 本机密钥绝不进镜像：compose 通过 environment 注入 ENCRYPTION_KEY 等
.env
.env.*

# 过程文档（截图都在 docs/ 下，整目录排除即可。
# 不全局排除 *.png / *.jpg，否则 public/ 里后续新增的图标会被误挡在镜像外）
docs
doc

# 本机脚本与临时文件
start-dev.cmd
stop-dev.cmd
tmp-*
*.log
.DS_Store
