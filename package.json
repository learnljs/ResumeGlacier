{
  "name": "resume-glacier",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "ResumeGlacier — Self-hosted AI resume screening for small HR teams. IMAP ingestion, two-tier text extraction (visual sort → Tesseract OCR), position-aware iceberg model evaluation, versioned prompts, and Webhook export.",
  "keywords": [
    "resume",
    "screening",
    "ai",
    "hr",
    "recruitment",
    "imap",
    "ocr",
    "iceberg-model",
    "self-hosted",
    "webhook"
  ],
  "license": "MIT",
  "author": "learnLJS",
  "homepage": "https://github.com/learnLJS/resume-glacier",
  "repository": {
    "type": "git",
    "url": "https://github.com/learnLJS/resume-glacier.git"
  },
  "bugs": {
    "url": "https://github.com/learnLJS/resume-glacier/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=100",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "typecheck:app": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:setup": "prisma generate && prisma db push",
    "db:demo": "tsx scripts/seed-demo-data.ts",
    "postinstall": "node -e \"const fs=require('fs');const src='node_modules/react-pdf/node_modules/pdfjs-dist/build/pdf.worker.min.mjs';const dst='public/pdf.worker.min.mjs';if(fs.existsSync(src)){fs.copyFileSync(src,dst);console.log('pdf.worker.min.mjs synced to public/')}else{console.warn('pdf.worker.min.mjs not found, skipping sync')}\""
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@radix-ui/react-dialog": "1.1.17",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-tooltip": "1.2.11",
    "canvas": "3.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "imapflow": "1.2.16",
    "lucide-react": "0.562.0",
    "mailparser": "3.9.5",
    "mammoth": "1.12.0",
    "next": "16.1.1",
    "node-cron": "4.2.1",
    "openai": "6.32.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.9.155",
    "react": "19.2.3",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.3",
    "react-is": "19.2.7",
    "react-markdown": "10.1.0",
    "react-pdf": "10.4.1",
    "recharts": "3.8.1",
    "remark-gfm": "^4.0.1",
    "sharp": "0.34.5",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "1.0.7",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "25.0.8",
    "@types/node-cron": "3.0.11",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.23",
    "eslint": "9.39.5",
    "eslint-config-next": "16.1.1",
    "postcss": "8.5.16",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "xlsx": "0.18.5"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "canvas@3.2.3": true,
    "prisma@5.22.0": true,
    "sharp@0.34.5": true,
    "tesseract.js@7.0.0": true,
    "esbuild@0.28.1": true
  }
}
